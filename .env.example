# =============================================================
# Sleep Monitor — Environment Variables Template
# Copy this file to .env.development and fill in values.
# NEVER commit .env.development, .env.staging, or .env.production.
# =============================================================

# ── Compose ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sleep-monitor
ENVIRONMENT=development

# ── MQTT ──────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASSWORD=change_me_now

# ── Python Publisher ──────────────────────────────────────────
PATIENT_ID=patient-001
PUBLISH_INTERVAL=1.0
LOOP_CSV=true
STATS_INTERVAL=10

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=sleep_monitor
POSTGRES_USER=sleep_user
POSTGRES_PASSWORD=change_me_now
DATABASE_URL=postgresql://sleep_user:change_me_now@postgres:5432/sleep_monitor

# ── Backend API ───────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=replace_with_32_char_minimum_secret

# ── Docker image tags (local dev uses latest) ─────────────────
MOSQUITTO_IMAGE=sleep-monitor/mosquitto:latest
PUBLISHER_IMAGE=sleep-monitor/python-publisher:latest
API_IMAGE=sleep-monitor/backend-api:latest

# ── AWS (only needed for cloud deployment) ────────────────────
# AWS_REGION=ap-southeast-1
# AWS_ACCOUNT_ID=123456789012
# ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
