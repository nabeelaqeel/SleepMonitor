# =============================================================
# Sleep Monitor — Environment Variables Template
# Copy this file to .env.development and fill in values.
# .env.development is gitignored — NEVER commit it.
# =============================================================

# ── Compose ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sleep-monitor

# ── PostgreSQL (Docker) ───────────────────────────────────────
POSTGRES_DB=sleep_monitor
POSTGRES_USER=sleep_user
POSTGRES_PASSWORD=change_me_now
# Containerized-stack DSN — services reach Postgres by compose hostname
# `postgres`. Host-venv runs flip back to the commented localhost line:
DATABASE_URL=postgresql://sleep_user:change_me_now@postgres:5432/sleep_monitor
#DATABASE_URL=postgresql://sleep_user:change_me_now@localhost:5432/sleep_monitor

# ── Auth API (api/main.py, runs on the host) ──────────────────
# Signs the HS256 JWT issued on login. REQUIRED — must be >= 32 characters
# or the API refuses to start:
#   echo "JWT_SECRET=$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >> .env.development
# NOTE: copying this file as-is fails ON PURPOSE — the placeholder is long
# enough to look valid, but api/config.py rejects values containing
# "change_me" so a template can never go live as a signing key.
JWT_SECRET=change_me_random_hex_at_least_32_characters_long
# Demo account seeding (default true; set false to provision users yourself)
SEED_DEMO_USERS=true

# ── MQTT (stack broker: eclipse-mosquitto:2, LOCKED) ──────────
# Compose hostname of the broker service. Host-venv runs flip back to the
# commented localhost line. MQTT_USER/MQTT_PASSWORD must match the sm entry
# in mosquitto/passwd (created per README "Run the Full Stack"):
MQTT_HOST=broker
#MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=sm
MQTT_PASSWORD=
INGEST_CLIENT_ID=sleep-ingest-001
# MQTTv5 persistent session — broker queues QoS 1/2 while the worker is down.
SESSION_EXPIRY=3600
FLUSH_INTERVAL=1.0
FLUSH_MAX=50

# ── Session / patient identity ────────────────────────────────
PATIENT_ID=patient-001
# Matches the seeded patient user in postgres/init/01_schema.sql
PATIENT_UUID=00000000-0000-0000-0000-000000000002
DEVICE_ID=sleepband-001

# ── Publisher (publisher/publisher.py) ────────────────────────
# Path is relative to the repository root; run the publisher from there.
CSV_PATH=data/sleep_data_realistic.csv
PUBLISH_INTERVAL=1.0
# LOOP_CSV=true

# ── AI recommendation DEMO (ai/demo.py — only used with --profile ai-demo) ──
# patientId of the app account that should receive the demo bands (the app
# keys stored recommendations by payload.patientId). The seeded patient user:
AI_DEMO_PATIENT_ID=00000000-0000-0000-0000-000000000002
# Seconds between demo publishes while demo mode is ON
AI_DEMO_INTERVAL=60
