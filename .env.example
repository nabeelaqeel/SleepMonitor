# =============================================================
# Sleep Monitor — Environment Variables Template
# Copy this file to .env.development and fill in values.
# .env.development is gitignored — NEVER commit it.
# =============================================================

# ── Compose ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sleep-monitor

# ── PostgreSQL (Docker) ───────────────────────────────────────
POSTGRES_DB=sleep_monitor
POSTGRES_USER=sleep_user
POSTGRES_PASSWORD=change_me_now
# Host-side DSN — the ingest worker runs on the host, not in a container.
DATABASE_URL=postgresql://sleep_user:change_me_now@localhost:5432/sleep_monitor

# ── MQTT (native mosquitto — anonymous on localhost) ──────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
INGEST_CLIENT_ID=sleep-ingest-001
# MQTTv5 persistent session — broker queues QoS 1/2 while the worker is down.
SESSION_EXPIRY=3600
FLUSH_INTERVAL=1.0
FLUSH_MAX=50

# ── Session / patient identity ────────────────────────────────
PATIENT_ID=patient-001
# Matches the seeded patient user in postgres/init/01_schema.sql
PATIENT_UUID=00000000-0000-0000-0000-000000000002
DEVICE_ID=sleepband-001

# ── Publisher (python-publisher/publisher.py) ─────────────────
# Path is relative to the repository root; run the publisher from there.
CSV_PATH=sleep_data_realistic.csv
PUBLISH_INTERVAL=1.0
# LOOP_CSV=true
