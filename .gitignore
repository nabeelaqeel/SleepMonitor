# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.development
.env.staging
.env.production

# AWS broker credential file — generated on the server, never committed
# (mosquitto_passwd -c /config/passwd — see the author-side deployment runbook)
mosquitto/passwd

# EAS release config — real values are filled locally from eas.example.json
# at deploy time (see the author-side deployment runbook); the repo never
# carries the real broker password or endpoints.
app/eas.json

# personal working notes — author-local, not for the repo
notes/

# Python virtualenvs (never track these — .venv/ was committed by accident once)
.venv/
.venv-dev/

# Python bytecode
__pycache__/
*.py[cod]

# Generated benchmark output
evaluation_results.json

# typescript
*.tsbuildinfo

# generated native folders (the Expo project now lives in app/)
app/ios
app/android

# AI module artifacts (kept local, never committed)
ai/models/rf_phase2.joblib
ai/models/*.pkl
ai/models/*.joblib

# Claude Code agent config — local only
.claude/
CLAUDE.md

# Graphify — local only
.opencode/
AGENTS.md
graphify-out/

# Graphify ignore rules (local)
.graphifyignore
