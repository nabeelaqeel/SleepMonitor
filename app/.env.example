# =============================================================
# Expo app environment — copy to app/.env.development
#
# Expo only reads env files inside its own project root (app/),
# which is why this is separate from the repo-root .env.development
# that the Python scripts use.
#
# Only EXPO_PUBLIC_* variables are inlined into the bundle, and
# they are baked in at bundle time — restart `npx expo start`
# after changing this file.
# =============================================================

# Laptop's LAN IP running the Mosquitto broker.
# Find it with:  hostname -I   (Linux)  |  ipconfig  (Windows)
# The phone must be on the same network.
EXPO_PUBLIC_BROKER_IP=192.168.1.100

# Laptop's LAN IP running the auth API (api/, uvicorn on :8000).
# Same network requirement as the broker; the API must be running to log in.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Broker credentials — only needed against a locked (AWS) broker; the laptop's
# anonymous broker ignores them. Match the server's .env.development values.
# EXPO_PUBLIC_MQTT_USER=sm
# EXPO_PUBLIC_MQTT_PASSWORD=<broker password>

# Demo-only escape hatch (docs/DEPLOYMENT_NOTES.md §8): set true to allow
# plain-HTTP login against a PUBLIC address (no TLS termination). Leave unset
# for anything real — the transport guard blocks public plain HTTP by default.
# EXPO_PUBLIC_ALLOW_PLAIN_HTTP=true
