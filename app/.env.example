# =============================================================
# Expo app environment — copy to app/.env.development
#
# Expo only reads env files inside its own project root (app/),
# which is why this is separate from the repo-root .env.development
# that the Python scripts use.
#
# Only EXPO_PUBLIC_* variables are inlined into the bundle, and
# they are baked in at bundle time — restart `npx expo start`
# after changing this file.
# =============================================================

# Laptop's LAN IP running the Mosquitto broker.
# Find it with:  hostname -I   (Linux)  |  ipconfig  (Windows)
# The phone must be on the same network.
EXPO_PUBLIC_BROKER_IP=192.168.1.100
